	partition fact_wisman_bulanan = m
		mode: import
		source = ```
				let
					Source = Csv.Document(File.Contents(FolderData & "\fact_wisman_bulanan.csv"), [Delimiter = ",", Columns = 4, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
					PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					ChangedType = Table.TransformColumnTypes(PromotedHeaders, {{"tahun", Int64.Type}, {"bulan_ke", Int64.Type}, {"bulan", type text}, {"kunjungan_wisman", Int64.Type}})
				in
					ChangedType
				```
